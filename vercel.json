{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/generate-report.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/brand-snapshot",
      "destination": "https://qck-brand-snapshot.vercel.app/brand-snapshot"
    },
    {
      "source": "/brand-snapshot/:path*",
      "destination": "https://qck-brand-snapshot.vercel.app/brand-snapshot/:path*"
    }
  ]
}
